@{
    Layout = null; // Single page app style for this index
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المقاسات - تصميم פاخر</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --gold-primary: #D4AF37;
            --gold-light: #F9E596;
            --gold-dark: #AA8222;
            --bg-dark: #0A0A0A;
            --surface-dark: #141414;
            --surface-light: #1E1E1E;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg-dark);
            color: #fff;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(212, 175, 55, 0.05), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(212, 175, 55, 0.08), transparent 25%);
            min-height: 100vh;
        }

        /* شريط الإضاءة الأمامي الفاخر بالخوذة */
        .glowing-header {
            box-shadow: 0 4px 30px rgba(212, 175, 55, 0.15);
            border-bottom: 1px solid rgba(212, 175, 55, 0.3);
            background: linear-gradient(90deg, rgba(10,10,10,1) 0%, rgba(20,20,20,1) 50%, rgba(10,10,10,1) 100%);
        }

        /* البطاقة الممركزة بعرض أقصى 620 بكسل */
        .card-container {
            max-width: 620px;
            margin: 0 auto;
            background: linear-gradient(145deg, var(--surface-dark), var(--surface-light));
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            transition: all 0.4s ease;
        }

        .card-container:hover {
            box-shadow: 0 15px 50px rgba(212,175,55,0.15), inset 0 0 0 1px rgba(212,175,55,0.4);
            border-color: rgba(212, 175, 55, 0.4);
        }

        /* عناصر تفاعلية */
        .input-field {
            background-color: rgba(0,0,0,0.5);
            border: 1px solid #333;
            color: #fff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .input-field:focus {
            outline: none;
            border-color: var(--gold-primary);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
            transform: translateY(-2px);
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark));
            color: var(--bg-dark);
            font-weight: bold;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .btn-gold::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
            transform: rotate(45deg);
            animation: shine 3s infinite;
        }

        .btn-gold:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4);
        }

        @@keyframes shine {
            0% { left: -100%; top: -100%; }
            20% { left: 100%; top: 100%; }
            100% { left: 100%; top: 100%; }
        }

        .section-title {
            background: -webkit-linear-gradient(45deg, var(--gold-light), var(--gold-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* تأثير الدراجة التفاعلية (Interactive bike icon) */
        .bike-icon {
            transition: transform 0.5s ease-in-out;
        }
        form:hover .bike-icon {
            transform: translateX(-20px);
        }
    </style>
</head>
<body class="pb-16 pt-6 px-4">

    <!-- شريط الإضاءة الأمامي الفاخر بالخوذة -->
    <header class="glowing-header fixed top-0 w-full z-50 py-4 px-6 flex justify-between items-center text-center">
        <div class="mx-auto flex items-center justify-center gap-3">
            <!-- أيقونة خوذة / شعار פاخر -->
            <svg class="text-[#D4AF37] w-8 h-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.48 2 2 6.48 2 12c0 2.22.73 4.27 1.95 5.9L5.3 16.5C4.48 15.24 4 13.68 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8c0 1.68-.48 3.24-1.3 4.5l1.35 1.4C21.27 16.27 22 14.22 22 12c0-5.52-4.48-10-10-10z"/>
                <path d="M12 22c-2.22 0-4.27-.73-5.9-1.95l1.4-1.35C8.76 19.52 10.32 20 12 20c1.68 0 3.24-.48 4.5-1.3l1.35 1.4C16.27 21.27 14.22 22 12 22z"/>
                <circle cx="12" cy="12" r="4"/>
            </svg>
            <h1 class="text-2xl font-bold section-title tracking-wide">نظام المقاسات الفاخر</h1>
        </div>
    </header>

    <div class="mt-24 space-y-10">
        <!-- البطاقة الممركزة بعرض أقصى 620 بكسل -->
        <div class="card-container p-8 relative overflow-hidden">
            <!-- عناصر من الهندسة والنقوش -->
            <div class="absolute top-0 right-0 opacity-10 pointer-events-none">
                <svg width="150" height="150" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="40" stroke="#D4AF37" stroke-width="2" fill="none" stroke-dasharray="5 5"></circle>
                    <polygon points="50,15 85,80 15,80" stroke="#D4AF37" stroke-width="1" fill="none"></polygon>
                </svg>
            </div>

            <div class="text-center mb-8 relative z-10">
                <h2 class="text-3xl font-extrabold section-title mb-2">تسجيل المقاسات والفواتير</h2>
                <div class="flex justify-center items-center gap-2 text-gray-400 text-sm">
                    <!-- الدراجة التفاعلية -->
                    <span class="bike-icon">🏍️</span> 
                    <p>أدخل تفاصيل العميل والمقاسات للحساب الآلي</p>
                </div>
            </div>

            <form id="maqasForm" class="space-y-6 relative z-10">
                <!-- أساسيات العميل -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">اسم العميل</label>
                        <input type="text" id="CustomerName" required class="input-field w-full px-4 py-3 rounded-lg" placeholder="أحمد علي">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">رقم الهاتف</label>
                        <input type="tel" id="Phone" required class="input-field w-full px-4 py-3 rounded-lg" placeholder="05XXXXXXXX">
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">نوع القماش والخيارات</label>
                    <input type="text" id="FabricType" class="input-field w-full px-4 py-3 rounded-lg" placeholder="صوف إنجليزي...">
                </div>

                <!-- المقاسات الآلية -->
                <div class="border-t border-gray-700/50 pt-6 mt-6">
                    <h3 class="text-lg font-bold text-[#D4AF37] mb-4">المقاسات (سم)</h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الطول</label>
                            <input type="number" step="0.5" id="Length" required class="input-field w-full px-3 py-2 rounded-lg text-center" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الكتف</label>
                            <input type="number" step="0.5" id="Shoulder" required class="input-field w-full px-3 py-2 rounded-lg text-center" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الخصر</label>
                            <input type="number" step="0.5" id="Waist" required class="input-field w-full px-3 py-2 rounded-lg text-center" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الرقبة</label>
                            <input type="number" step="0.5" id="Neck" required class="input-field w-full px-3 py-2 rounded-lg text-center" placeholder="0">
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الذراع</label>
                            <input type="number" step="0.5" id="Arm" required class="input-field w-full px-3 py-2 rounded-lg text-center" placeholder="0">
                        </div>
                    </div>
                </div>

                <!-- الحسابات المالية -->
                <div class="border-t border-gray-700/50 pt-6 mt-6">
                    <h3 class="text-lg font-bold text-[#D4AF37] mb-4">المالية والحالة</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">الإجمالي</label>
                            <input type="number" step="0.1" id="TotalPrice" class="input-field w-full px-3 py-2 rounded-lg text-center financial-input" placeholder="0" required>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">المدفوع</label>
                            <input type="number" step="0.1" id="Paid" class="input-field w-full px-3 py-2 rounded-lg text-center financial-input" placeholder="0" required>
                        </div>
                        <div>
                            <label class="block text-xs text-gray-400 mb-1">إعلانات (عربون)</label>
                            <input type="number" step="0.1" id="AdvancePayment" class="input-field w-full px-3 py-2 rounded-lg text-center financial-input" placeholder="0" required>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between bg-black/60 p-4 rounded-lg border border-[#D4AF37]/40 shadow-inner">
                        <span class="text-gray-300 font-medium">المتبقي آلياً:</span>
                        <span id="RemainingValue" class="text-2xl font-black text-[#D4AF37]">0.00 <span class="text-sm font-normal">ر.س</span></span>
                    </div>

                    <div class="mt-4">
                        <label class="block text-xs text-gray-400 mb-1">حالة العمل</label>
                        <select id="JobStatus" class="input-field w-full px-3 py-2 rounded-lg">
                            <option value="قيد الانتظار">قيد الانتظار</option>
                            <option value="قيد التنفيذ">قيد التنفيذ</option>
                            <option value="جاهز للتسليم">جاهز للتسليم</option>
                            <option value="مكتمل">مكتمل</option>
                        </select>
                    </div>
                </div>

                <div id="alertBox" class="hidden p-4 rounded-lg text-center text-sm font-bold"></div>

                <button type="submit" class="btn-gold w-full py-4 rounded-xl text-lg mt-8 flex justify-center items-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    حفظ الطلب والدفع لـ API
                </button>
            </form>
        </div>
    </div>

    <!-- تأكد من تعديل الـ URL ليطابق منفذ مشروع الـ API الخاص بك (مثال: https://localhost:5001) -->
    <script>
        const API_BASE_URL = "http://localhost:5041"; // API running on port 5041
        
        const financialInputs = document.querySelectorAll('.financial-input');
        const remainingDisplay = document.getElementById('RemainingValue');

        function calculateRemaining() {
            const total = parseFloat(document.getElementById('TotalPrice').value) || 0;
            const paid = parseFloat(document.getElementById('Paid').value) || 0;
            const advance = parseFloat(document.getElementById('AdvancePayment').value) || 0;
            const remaining = total - (paid + advance);
            remainingDisplay.innerHTML = `${remaining.toFixed(2)} <span class="text-sm font-normal">ر.س</span>`;
        }

        financialInputs.forEach(input => {
            input.addEventListener('input', calculateRemaining);
        });

        document.getElementById('maqasForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const btn = e.target.querySelector('button[type="submit"]');
            const alertBox = document.getElementById('alertBox');
            btn.innerHTML = '<div class="animate-spin rounded-full h-5 w-5 border-b-2 border-black inline-block"></div> جاري النشر لـ API...';
            btn.disabled = true;

            const data = {
                CustomerName: document.getElementById('CustomerName').value,
                Phone: document.getElementById('Phone').value,
                FabricType: document.getElementById('FabricType').value,
                Length: parseFloat(document.getElementById('Length').value) || 0,
                Shoulder: parseFloat(document.getElementById('Shoulder').value) || 0,
                Waist: parseFloat(document.getElementById('Waist').value) || 0,
                Neck: parseFloat(document.getElementById('Neck').value) || 0,
                Arm: parseFloat(document.getElementById('Arm').value) || 0,
                TotalPrice: parseFloat(document.getElementById('TotalPrice').value) || 0,
                Paid: parseFloat(document.getElementById('Paid').value) || 0,
                AdvancePayment: parseFloat(document.getElementById('AdvancePayment').value) || 0,
                JobStatus: document.getElementById('JobStatus').value
            };

            try {
                // ارسال الطلب للـ API
                const response = await fetch(`${API_BASE_URL}/api/Maqas`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    alertBox.className = 'p-4 rounded-lg text-center text-sm font-bold bg-green-500/20 text-green-400 border border-green-500';
                    alertBox.textContent = '✅ تم إرسال البيانات للتخزين بنجاح!';
                    alertBox.classList.remove('hidden');
                    e.target.reset();
                    calculateRemaining();
                } else {
                    throw new Error('فشل الرد من الخادم');
                }
            } catch (err) {
                alertBox.className = 'p-4 rounded-lg text-center text-sm font-bold bg-red-500/20 text-red-400 border border-red-500';
                alertBox.textContent = '❌ فشل الاتصال بالـ API (' + err.message + ') تأكد أن الـ API يعمل';
                alertBox.classList.remove('hidden');
            } finally {
                btn.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> حفظ الطلب والدفع لـ API';
                btn.disabled = false;
                setTimeout(() => alertBox.classList.add('hidden'), 5000);
            }
        });
    </script>
</body>
</html>
