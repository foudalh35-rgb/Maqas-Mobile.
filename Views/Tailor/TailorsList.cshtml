@model IEnumerable<YourProjectName.Models.TailorViewModel>

@{
    ViewData["Title"] = "قائمة الخياطين";
    // إذا كنت تستخدم Layout مشترك يحتوي على القائمة الجانبية، اتركه كما هو
    // Layout = "_CustomerLayout"; 
}

<div class="tailors-section" style="background-color: #0b0b0b; min-height: 100vh; padding: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; direction: rtl; color: #fff;">
    <div style="max-width: 900px; margin: 0 auto;">
        
        <!-- الهيدر العلوي الخاص بالصفحة -->
        <div style="display: flex; justify-content: space-between; align-items: center; background-color: #1a1a1a; padding: 15px 25px; border-radius: 8px; border-right: 5px solid #d4af37; margin-bottom: 25px; border: 1px solid #262626;">
            <h2 style="margin: 0; font-size: 1.3rem; color: #d4af37; font-weight: 600;">قائمة الخياطين</h2>
            <span style="color: #8c8c8c; font-size: 0.9rem;">الرئيسية &gt; قائمة الخياطين</span>
        </div>

        <!-- قائمة الخياطين المستوحاة من الواجهة الأولى ومتناسقة مع الويب -->
        <div class="tailors-list-container" style="display: flex; flex-direction: column; gap: 15px;">
            
            @if (Model != null && Model.Any())
            {
                foreach (var tailor in Model)
                {
                    <!-- كرت الخياط -->
                    <div class="tailor-web-card" style="display: flex; align-items: center; justify-content: space-between; background-color: #161616; border: 1px solid #262626; padding: 15px 25px; border-radius: 10px; cursor: pointer; transition: all 0.2s ease-in-out;">
                        
                        <!-- القسم الأيمن: الصورة والمعلومات -->
                        <div style="display: flex; align-items: center; gap: 20px;">
                            
                            <!-- دائرة الصورة الشخصية للخياط محاطة بإطار ذهبي -->
                            <div style="width: 55px; height: 55px; border-radius: 50%; background-color: #262626; border: 2px solid #d4af37; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(tailor.ImageUrl))
                                {
                                    <img src="@tailor.ImageUrl" alt="@tailor.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <!-- أيقونة افتراضية في حال عدم توفر صورة -->
                                    <svg width="28" height="28" fill="#d4af37" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16 v-2c0-2.66-5-4-8-4z"/>
                                    </svg>
                                }
                            </div>

                            <!-- تفاصيل الخياط -->
                            <div style="text-align: right;">
                                <h3 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #ffffff; font-weight: 500;">@tailor.Name</h3>
                                <p style="margin: 0; font-size: 0.9rem; color: #a0a0a0;">@tailor.Description</p>
                            </div>
                        </div>

                        <!-- القسم الأيسر: سهم الانتقال للتفاصيل -->
                        <div class="arrow-icon" style="color: #d4af37; font-size: 1.4rem; transition: transform 0.2s;">
                            <i class="fas fa-chevron-left"></i>
                        </div>

                    </div>
                }
            }
            else
            {
                <!-- حالة عدم وجود بيانات تجريبية في الـ Model -->
                <div style="text-align: center; padding: 40px; color: #666; background-color: #161616; border-radius: 10px; border: 1px dashed #262626;">
                    لا يوجد خياطين متاحين حالياً.
                </div>
            }

        </div>
    </div>
</div>

<style>
    .tailor-web-card:hover {
        background-color: #1f1f1f !important;
        border-color: #d4af37 !important;
        transform: scale(1.01);
        box-shadow: 0 4px 15px rgba(214, 175, 55, 0.05);
    }
    
    .tailor-web-card:hover .arrow-icon {
        transform: translateX(-5px);
    }
</style>
